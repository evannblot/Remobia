# Documentation uniquement : aucune adresse ni clé n’est configurée.
# En développement Cloudflare, renseigner ces clés dans .dev.vars (ignoré Git),
# ou utiliser le mécanisme d’injection de bindings de l’hébergement.
# Ce fichier .env.example n’est pas chargé par l’API.
# En production, configurer les bindings du Worker ; RESEND_API_KEY est un secret.
# Sur Vercel, configurer les variables dans les paramètres privés du projet.
# Adresses simples, sans nom d’affichage ; domaine expéditeur vérifié chez Resend.
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
RESEND_API_KEY=
# Email du compte propriétaire autorisé à gérer les annonces. Configuré côté serveur.
SITE_ADMIN_EMAIL=
# Vercel seulement : n’activer qu’après confirmation réelle de réception.
EMAIL_DELIVERY_ENABLED=
# Base Neon Postgres et authentification gérée Neon.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Facultatif : URL canonique affichée dans la console si l’intégration fournit une adresse obsolète.
NEON_AUTH_BASE_URL_OVERRIDE=
# Facultatif : origine exacte de redirection OAuth observée pour la même branche Neon.
NEON_AUTH_REDIRECT_ORIGIN=
NEON_AUTH_COOKIE_SECRET=
# Stockage Vercel Blob privé connecté au projet, authentifié par OIDC.
BLOB_STORE_ID=
# Facultatif en développement local ; ne pas exposer au navigateur.
BLOB_READ_WRITE_TOKEN=
